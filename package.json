{
  "name": "melinaoffice",
  "displayName": "Melina Office",
  "description": "Open and edit Word, Excel and PowerPoint files inside VS Code and code-server.",
  "version": "1.1.0",
  "publisher": "acane",
  "license": "Apache-2.0",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": ["Other"],
  "main": "./vscode/extension.js",
  "extensionKind": ["workspace"],
  "activationEvents": [
    "onCustomEditor:melinaoffice.ecrivaine",
    "onCustomEditor:melinaoffice.matheuse",
    "onCustomEditor:melinaoffice.oratrice",
    "onCommand:melinaoffice.open",
    "onCommand:melinaoffice.newDocx",
    "onCommand:melinaoffice.newXlsx",
    "onCommand:melinaoffice.newPptx"
  ],
  "contributes": {
    "commands": [
      {
        "command": "melinaoffice.open",
        "title": "Open in Melina Office",
        "category": "Melina Office"
      },
      {
        "command": "melinaoffice.newDocx",
        "title": "Word Document (.docx)",
        "category": "Melina Office"
      },
      {
        "command": "melinaoffice.newXlsx",
        "title": "Excel Workbook (.xlsx)",
        "category": "Melina Office"
      },
      {
        "command": "melinaoffice.newPptx",
        "title": "PowerPoint Presentation (.pptx)",
        "category": "Melina Office"
      }
    ],
    "menus": {
      "file/newFile": [
        { "command": "melinaoffice.newDocx", "group": "file" },
        { "command": "melinaoffice.newXlsx", "group": "file" },
        { "command": "melinaoffice.newPptx", "group": "file" }
      ],
      "explorer/context": [
        {
          "command": "melinaoffice.open",
          "when": "resourceExtname =~ /\\.(docx|docm|dotx|dotm|xlsx|xlsm|xltx|xltm|pptx|pptm|ppsx|ppsm|potx|potm|rtf|csv|tsv|md|markdown)$/i",
          "group": "navigation"
        }
      ]
    },
    "customEditors": [
      {
        "viewType": "melinaoffice.ecrivaine",
        "displayName": "Ecrivaine",
        "selector": [
          { "filenamePattern": "*.docx" },
          { "filenamePattern": "*.docm" },
          { "filenamePattern": "*.dotx" },
          { "filenamePattern": "*.dotm" }
        ],
        "priority": "default"
      },
      {
        "viewType": "melinaoffice.ecrivaine",
        "displayName": "Ecrivaine",
        "selector": [
          { "filenamePattern": "*.rtf" },
          { "filenamePattern": "*.htm" },
          { "filenamePattern": "*.html" },
          { "filenamePattern": "*.txt" },
          { "filenamePattern": "*.md" },
          { "filenamePattern": "*.markdown" },
          { "filenamePattern": "*.zip" },
          { "filenamePattern": "*.doc" }
        ],
        "priority": "option"
      },
      {
        "viewType": "melinaoffice.matheuse",
        "displayName": "Matheuse",
        "selector": [
          { "filenamePattern": "*.xlsx" },
          { "filenamePattern": "*.xlsm" },
          { "filenamePattern": "*.xltx" },
          { "filenamePattern": "*.xltm" }
        ],
        "priority": "default"
      },
      {
        "viewType": "melinaoffice.matheuse",
        "displayName": "Matheuse",
        "selector": [
          { "filenamePattern": "*.csv" },
          { "filenamePattern": "*.tsv" },
          { "filenamePattern": "*.prn" },
          { "filenamePattern": "*.xml" },
          { "filenamePattern": "*.xls" },
          { "filenamePattern": "*.htm" },
          { "filenamePattern": "*.html" }
        ],
        "priority": "option"
      },
      {
        "viewType": "melinaoffice.oratrice",
        "displayName": "Oratrice",
        "selector": [
          { "filenamePattern": "*.pptx" },
          { "filenamePattern": "*.pptm" },
          { "filenamePattern": "*.ppsx" },
          { "filenamePattern": "*.ppsm" },
          { "filenamePattern": "*.potx" },
          { "filenamePattern": "*.potm" }
        ],
        "priority": "default"
      },
      {
        "viewType": "melinaoffice.oratrice",
        "displayName": "Oratrice",
        "selector": [
          { "filenamePattern": "*.ppt" }
        ],
        "priority": "option"
      }
    ],
    "mcpServerDefinitionProviders": [
      {
        "id": "melinaoffice",
        "label": "Melina Office"
      }
    ]
  }
}
